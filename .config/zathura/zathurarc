# Catppuccin Mocha para zathura (puerto oficial catppuccin/zathura)
set notification-error-bg   "#f38ba8"
set notification-error-fg   "#1e1e2e"
set notification-warning-bg "#f9e2af"
set notification-warning-fg "#1e1e2e"
set notification-bg         "#a6e3a1"
set notification-fg         "#1e1e2e"

set completion-bg           "#313244"
set completion-fg           "#cdd6f4"
set completion-group-bg     "#11111b"
set completion-group-fg     "#89b4fa"
set completion-highlight-bg "#585b70"
set completion-highlight-fg "#cdd6f4"

set index-bg                "#313244"
set index-fg                "#cdd6f4"
set index-active-bg         "#585b70"
set index-active-fg         "#cdd6f4"

set inputbar-bg             "#313244"
set inputbar-fg             "#cdd6f4"
set statusbar-bg            "#313244"
set statusbar-fg            "#cdd6f4"

set highlight-color         "#f9e2af"
set highlight-active-color  "#fab387"

set default-bg              "#1e1e2e"
set default-fg              "#cdd6f4"

set render-loading          true
set render-loading-bg       "#1e1e2e"
set render-loading-fg       "#cdd6f4"

# recolor: invierte el PDF a la paleta Mocha. Se alterna en caliente con "r".
set recolor-lightcolor      "#1e1e2e"
set recolor-darkcolor       "#cdd6f4"
set recolor                 true

set font "FiraCode Nerd Font Mono 10"
set selection-clipboard clipboard
